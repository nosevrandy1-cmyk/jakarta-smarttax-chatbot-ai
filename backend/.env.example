OLLAMA_HOST=http://localhost:11434
OLLAMA_SECONDARY_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_DRAFTING_MODEL=gemma4:12b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=1.0
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
OLLAMA_THINK=true
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
CHROMA_PERSIST_DIR=./smarttax_vectordb
CHROMA_COLLECTION=jakarta_smarttax_knowledge_official
QDRANT_URL=
QDRANT_ACTIVE_COLLECTION=jakarta_smarttax_sources
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google sign-in is required. Fill these in the existing .env; do not overwrite it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_PUBLIC_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Only these Google-verified accounts can use the dashboard and management APIs.
AUTH_DEVELOPER_EMAILS=
# Optional pilot allowlist. Empty permits any Google-verified account.
AUTH_ALLOWED_EMAILS=
